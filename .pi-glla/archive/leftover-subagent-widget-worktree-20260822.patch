+// View a specific subagent's conversation by ID
+export async function cmdViewSubagent(
+  arg: string,
+  ctx: ExtensionContext,
+): Promise<void> {
+  const SUBAGENT_MANAGER_KEY = Symbol.for("pi-subagents:manager");
+  const registry = (globalThis as any)[SUBAGENT_MANAGER_KEY] as
+    | {
+        getRecord?: (id: string) => any;
+        manager?: any;
+        abort?: (id: string) => boolean;
+        steer?: (id: string, message: string) => boolean;
+      }
+    | undefined;
+  if (!registry?.getRecord) {
+    ctx.ui.notify(
+      "No active subagent manager found. Subagents may not be running.",
+      "warning",
+    );
+    return;
+  }
+
+  if (!arg) {
+    // List available subagents
+    const manager = registry.manager;
+    if (manager?.listAgents) {
+      const agents = manager.listAgents().filter((a: any) => !a.parentAgentId);
+      if (agents.length === 0) {
+        ctx.ui.notify("No subagents found.", "info");
+        return;
+      }
+      // Load display helpers from pi-subagents (using require to avoid TS module resolution issues)
+      let getDisplayName: (type: string) => string;
+      let formatDuration: (startedAt: number, completedAt?: number) => string;
+      try {
+        // eslint-disable-next-line @typescript-eslint/no-var-requires
+        const mod = require("@tintinweb/pi-subagents/ui/agent-widget.js");
+        getDisplayName = mod.getDisplayName;
+        formatDuration = mod.formatDuration;
+      } catch {
+        getDisplayName = (t: string) => t;
+        formatDuration = (s: number, e?: number) =>
+          `${Math.round((e ?? Date.now() - s) / 1000)}s`;
+      }
+      const options = agents.map((a: any) => {
+        const dn = getDisplayName(a.type);
+        const dur = formatDuration(a.startedAt, a.completedAt);
+        return `${a.id} · ${dn} (${a.description}) · ${a.toolUses} tools · ${a.status} · ${dur}`;
+      });
+      const choice = await ctx.ui.select("Select subagent to view", options);
+      if (!choice) return;
+      const idx = options.indexOf(choice);
+      const record = agents[idx];
+      await viewSubagentConversation(ctx, record, registry);
+      return;
+    }
+    ctx.ui.notify(
+      "Usage: /glla subagent <id> — view a specific subagent's conversation",
+      "info",
+    );
+    return;
+  }
+
+  // View specific subagent by ID
+  const record = registry.getRecord(arg);
+  if (!record) {
+    ctx.ui.notify(`Subagent "${arg}" not found.`, "error");
+    return;
+  }
+  await viewSubagentConversation(ctx, record, registry);
+}
+
+async function viewSubagentConversation(
+  ctx: ExtensionContext,
+  record: any,
+  registry: any,
+): Promise<void> {
+  if (!record.session) {
+    ctx.ui.notify(
+      `Agent is ${record.status === "queued" ? "queued" : "completed/stopped"} — no session available.`,
+      "info",
+    );
+    return;
+  }
+
+  // Import ConversationViewer dynamically (using require to avoid TS module resolution issues)
+  let ConversationViewer: any;
